{
  "_version": "1.90.0",
  "sap.app": {
    "id": "airlineui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.34.0",
      "toolsId": "e482cd9a-2292-43ab-82a8-70e478be1160"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/airline/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "paymentService": {
        "uri": "/odata/v4/payment/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.154.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "airlineui.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "payment": {
        "dataSource": "paymentService",
        "settings": {
          "synchronizationMode": "None"
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "FlightsList",
          "target": "FlightsList"
        },
        {
          "pattern": "Flights({key}):?query:",
          "name": "FlightsObjectPage",
          "target": "FlightsObjectPage"
        }
      ],
      "targets": {
        "FlightsList": {
          "type": "Component",
          "id": "FlightsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Flights",
              "variantManagement": "Page",
              "navigation": {
                "Flights": {
                  "detail": {
                    "route": "FlightsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "FlightsObjectPage": {
          "type": "Component",
          "id": "FlightsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Flights",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.FieldGroup#GeneratedGroup": {
                  "actions": {
                    "payment": {
                      "press": ".extension.airlineui.ext.controller.FlightsObjectPageExtension.makePayment",
                      "visible": true,
                      "enabled": true,
                      "text": "Buy a Ticket"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "airlineui.ext.controller.FlightsObjectPageExtension"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
