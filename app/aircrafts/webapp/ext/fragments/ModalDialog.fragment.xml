<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="seatsModal"
        title="Seat reservations form"
        contentWidth="30rem">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="Initial seat number:" labelFor="initSeatNumber"/>
                <Input id="initSeatNumber"/>
            </VBox>
            <VBox class="sapUiSmallMargin">
                <Label text="Final seat number:" labelFor="finalSeatNumber"/>
                <Input id="finalSeatNumber"/>
            </VBox>
            <VBox class="sapUiSmallMargin">
                <Label text="Exclude Numbers(use ',' separator):" labelFor="excludeSeatNumbers"/>
                <Input id="excludeSeatNumbers"/>
            </VBox>
        </content>
        <beginButton>
            <Button text="Confirm" type="Emphasized" press=".onConfirmModal"/>
        </beginButton>
        <endButton>
            <Button text="Close" press=".onCloseModal"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
