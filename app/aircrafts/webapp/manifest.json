{
  "_version": "1.90.0",
  "sap.app": {
    "id": "aircrafts",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.34.0",
      "toolsId": "5288ab17-340f-4455-bece-af1cee2a43b8"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/airline/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Aircrafts-Aircrafts": {
          "semanticObject": "Aircrafts",
          "action": "Aircrafts",
          "title": "{{Aircrafts-Aircrafts.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.154.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "aircrafts.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "AircraftsList",
          "target": "AircraftsList"
        },
        {
          "pattern": "Aircrafts({key}):?query:",
          "name": "AircraftsObjectPage",
          "target": "AircraftsObjectPage"
        },
        {
          "pattern": "Aircrafts({key})/seats({key2}):?query:",
          "name": "AircraftsSeatsObjectPage",
          "target": "AircraftsSeatsObjectPage"
        }
      ],
      "targets": {
        "AircraftsList": {
          "type": "Component",
          "id": "AircraftsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Aircrafts",
              "variantManagement": "Page",
              "navigation": {
                "Aircrafts": {
                  "detail": {
                    "route": "AircraftsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "AircraftsObjectPage": {
          "type": "Component",
          "id": "AircraftsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Aircrafts",
              "navigation": {
                "seats": {
                  "detail": {
                    "route": "AircraftsSeatsObjectPage"
                  }
                }
              }
            }
          }
        },
        "AircraftsSeatsObjectPage": {
          "type": "Component",
          "id": "AircraftsSeatsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Aircrafts/seats"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "airline"
  }
}
