{
  "features": {
    "assert_integrity": "db"
  },
  "requires": {
    "[production]": {
      "auth": "ias",
      "db": {
        "kind": "hana"
      }
    },
    "[development]": {
      "auth": {
        "kind": "mocked",
        "users": {
          "secrets-user": {
            "password": "secrets123",
            "roles": [
              "ReadSecrets"
            ]
          }
        }
      }
    },
    "xsuaa": true,
    "db": {
      "[development]": {
        "kind": "sqlite",
        "impl": "@cap-js/sqlite",
        "credentials": {
          "url": "sqlite.db"
        }
      }
    }
  }
}