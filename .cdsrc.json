{
   "launchpad": {
      "basePath": "/launchpad",
      "theme": "sap_horizon",
      "version": "1.154.0",
      "locale": "",
      "template": "async"
    },
  "features": {
    "assert_integrity": "db"
  },
  "requires": {
    "[production]": {
      "auth": "ias",
      "db": {
        "kind": "hana"
      }
    },
    "[development]": {
      "auth": {
        "kind": "mocked",
        "users": {
          "secrets-user": {
            "password": "secrets123",
            "roles": [
              "ReadSecrets"
            ]
          },
          "ui-bob": {
            "password": "secrets123",
            "policies": [
                "airline.BusinessAdministrator"
              ]
          }
        }
      },
      "StripeApi": {
        "kind": "rest",
        "credentials": {
          "url": "https://api.stripe.com"
        }
      },
      "db": {
        "kind": "sqlite",
        "impl": "@cap-js/sqlite",
        "credentials": {
          "url": "sqlite.db"
        }
      }
    },
    "[hybrid]": {
      "db": {
        "kind": "hana",
        "impl": "@cap-js/hana"
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "customer": {
            "password": "1234",
            "policies": ["airline.BusinessAdministrator"]
          }
        }
      }
    },
    "xsuaa": true,
    "html5-repo": true
  }
}