{
  "features": {
    "assert_integrity": "db"
  },
  "requires": {
    "auth": {
      "[production]": "xsuaa"
    },
    "db": {
      "[development]": {
        "kind": "sqlite",
        "impl": "@cap-js/sqlite",
        "credentials": {
          "url": "sqlite.db"
        }
      },
      "[production]": {
        "kind": "hana"
      }
    }
  }
}