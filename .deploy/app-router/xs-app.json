
{
  "welcomeFile": "/xsuaa/",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/ias/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "ias",
      "csrfProtection": true
    },
    {
      "source": "^/xsuaa/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/ias/?$",
      "target": "/airlineui-0.0.1/index.html",
      "service": "html5-apps-repo-rt",
      "authenticationType": "ias"
    },
    {
      "source": "^/xsuaa/?$",
      "target": "/airlineui-0.0.1/index.html",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/ias/(.*)$",
      "target": "/airlineui-0.0.1/$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "ias"
    },
    {
      "source": "^/xsuaa/(.*)$",
      "target": "/airlineui-0.0.1/$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^(.*)$",
      "target": "/airlineui-0.0.1/$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}
