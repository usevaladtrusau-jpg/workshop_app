
{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/ias/(.*)$",
      "target": "/$1",
      "destination": "srv-api",
      "authenticationType": "ias",
      "csrfProtection": true
    },
    {
      "source": "^/xsuaa/(.*)$",
      "target": "/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^(.*)$",
      "target": "/airlineui-0.0.1/$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "ias"
    }
  ]
}
