{
 "welcomeFile": "/index.html",
 "authenticationMethod": "route",
 "routes": [
  {
   "source": "^(.*)$",
   "target": "$1",
   "localDir": ".",
   "authenticationType": "xsuaa"
  },
  {
   "source": "^/api/(.*)$",
   "target": "$1",
   "destination": "srv-api",
   "authenticationType": "xsuaa",
   "csrfProtection": true
  }
 ]
}
